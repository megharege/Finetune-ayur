# PostgreSQL Environment Variables
POSTGRES_USER=ayur_user
POSTGRES_PASSWORD=ayur_password_secure
POSTGRES_DB=ayur_db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Meilisearch
MEILI_HTTP_ADDR=meilisearch:7700
MEILI_MASTER_KEY=meili_master_key_secure_123

# Neo4j Graph DB
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password_secure

# MinIO (S3 compatible)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password_secure
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# App Secrets & Auth
SECRET_KEY=supersecretjwtkey_change_in_production_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM & External Services
LLM_PROVIDER=gemini
GEMINI_API_KEY=mock_gemini_api_key
RAZORPAY_KEY_ID=rzp_test_mockkey123
RAZORPAY_KEY_SECRET=rzp_test_mocksecret123
